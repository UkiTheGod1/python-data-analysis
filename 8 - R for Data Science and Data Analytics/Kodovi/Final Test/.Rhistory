library(readr)
library(ggplot2)
library(dplyr)
certifications <- read_csv("certifications.csv")
countries <- read_csv("countries.csv")
genres <- read_csv("genres.csv")
ratings <- read_csv("ratings.csv")
titles <- read_csv("titles.csv")
titles_genres <- titles |> left_join(genres)
titles_countries <- titles_genres |> left_join(countries)
titles_complete <- titles_countries |> left_join(ratings)
titles_complete <- titles_complete |>
mutate(
genre = factor(genre),
production_country = factor(production_country)
)
set.seed(123)
n <- nrow(titles_complete)
train_index <- sample(1:n, size = n * 0.8)
train_data <- titles_complete[train_index, ]
test_data <- titles_complete[-train_index, ]
test_data$genre <- factor(test_data$genre, levels = levels(train_data$genre))
test_data$production_country <- factor(test_data$production_country, levels = levels(train_data$production_country))
model <-  lm(imdb_score ~ genre + runtime + release_year + production_country, data = train_data)
summary(model)
predictions <- predict(model, newdata = test_data)
library(readr)
library(ggplot2)
library(dplyr)
certifications <- read_csv("certifications.csv")
countries <- read_csv("countries.csv")
genres <- read_csv("genres.csv")
ratings <- read_csv("ratings.csv")
titles <- read_csv("titles.csv")
titles_complete <- titles |>
inner_join(genres, by = "id") |>
inner_join(countries, by = "id") |>
inner_join(ratings, by = "id")
set.seed(123)
n <- nrow(titles_complete)
train_index <- sample(1:n, size = n * 0.8)
train_data <- titles_complete[train_index, ]
test_data <- titles_complete[-train_index, ]
model <-  lm(imdb_score ~ genre + runtime + release_year + production_country, data = train_data)
summary(model)
predictions <- predict(model, newdata = test_data)
library(readr)
predictions <- predict(model, newdata = test_data)
